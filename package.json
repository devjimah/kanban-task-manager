{
  "name": "kanban-task-manager",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "server"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "audit": "npm audit --audit-level=high",
    "db:start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-mongodb-rs0.ps1",
    "db:verify": "node scripts/mongodb-rs0.mjs verify --uri mongodb://127.0.0.1:27019/admin?replicaSet=rs0 --set rs0",
    "db:check-uri": "node scripts/check-mongodb-uri.mjs",
    "db:migrate:standalone": "node scripts/mongodb-rs0.mjs migrate --source mongodb://127.0.0.1:27017/kanban?directConnection=true --target mongodb://127.0.0.1:27019/kanban?replicaSet=rs0",
    "api:smoke": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/api-curl-smoke.ps1",
    "server:dev": "npm --workspace server run dev",
    "server:test": "npm --workspace server test",
    "server:build": "npm --workspace server run build",
    "check:all": "npm run check && npm --workspace server run check"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tailwindcss/vite": "^4.3.2",
    "@tanstack/react-query": "^5.101.2",
    "framer-motion": "^12.42.2",
    "lucide-react": "^0.563.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1",
    "tailwindcss": "^4.3.2",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^16.5.0",
    "jsdom": "^29.1.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.64.0",
    "vite": "^8.1.4",
    "vitest": "^4.1.10"
  }
}
